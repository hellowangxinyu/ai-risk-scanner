[Unit]
Description=AI Financial Risk Control (AI 财务风控)
After=network.target

[Service]
Type=simple
# 按实际解压路径修改下面两行
WorkingDirectory=/opt/fengkong/backend
ExecStart=/opt/fengkong/backend/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 1
# 访问口令：务必修改默认值！
Environment=APP_PASSWORD=change-me-please
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
